{
  "name": "@nostrautica/protocol",
  "version": "0.2.0",
  "description": "Shared Nostrautica protocol: kinds, zod schemas, crypto. Zero UI/server deps.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
