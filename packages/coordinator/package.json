{
  "name": "@nostrautica/coordinator",
  "version": "0.2.0",
  "description": "Nostrautica coordinator — headless Nostr client: STT, AI profiles, matchmaking.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "nostrautica-coordinator": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^2.2.0",
    "@internet-privacy/marmot-ts": "workspace:*",
    "@nostrautica/protocol": "workspace:*",
    "nostr-tools": "^2.10.4",
    "smol-toml": "^1.3.1",
    "undici": "^7.28.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
