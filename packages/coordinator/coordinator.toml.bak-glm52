# Nostrautica coordinator — cypherpunk.today (Venice v1, no Cashu).
# Identity is provided at launch via env NOSTRAUTICA_COORDINATOR_NSEC (see run-coordinator.sh).

[relays]
default = [
  "wss://relay.primal.net",
  "wss://relay.damus.io",
  "wss://nos.lol",
]

[providers.venice]
api_key_env = "VENICE_API_KEY"
require_private = true            # all four chosen models are Venice private-tier

[stt]
provider = "venice-stt"
model = "openai/whisper-large-v3" # private, best multilingual accuracy (incl. Slovak)

[models.summary]
provider = "venice"
model = "olafangensan-glm-4.7-flash-heretic"

[models.match]
provider = "venice"
model = "zai-org-glm-5-2"

[models.embed]
provider = "venice"
model = "text-embedding-bge-m3"

[matching]
prefilter_threshold = 50
prefilter_top_m = 30
prefilter_random = 10
top_k = 20
