{
  "name": "nostrautica",
  "version": "0.6.5",
  "private": true,
  "description": "Nostr-native event organizer built around networking and AI matchmaking",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --filter=!@nostrautica/e2e test",
    "typecheck": "pnpm -r --filter=!@nostrautica/e2e typecheck",
    "lint": "pnpm -r --filter=!@nostrautica/e2e lint",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "gen:registry": "pnpm --filter @nostrautica/protocol build && node scripts/gen-registry.mjs",
    "audit": "pnpm audit --audit-level high",
    "e2e": "pnpm --filter @nostrautica/e2e test",
    "e2e:smoke": "node e2e/orchestrator.mjs smoke",
    "e2e:integration": "node e2e/orchestrator.mjs integration",
    "e2e:chat": "node e2e/orchestrator.mjs chat",
    "e2e:full": "node e2e/orchestrator.mjs full"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "marked": "^18.0.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
